{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2015"],
    "moduleDetection": "force",
    "module": "node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
